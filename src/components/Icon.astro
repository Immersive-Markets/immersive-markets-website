---
interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 20, class: cls = "", strokeWidth = 1.75 } = Astro.props;

const icons = import.meta.glob(
  "/node_modules/lucide-static/icons/{users,megaphone,workflow,sparkles,clock,euro,shield-check,check,arrow-right,chevron-down,calendar,map-pin,book-open,handshake,search,layout-dashboard,list-checks,file-text,graduation-cap,message-circle,timer,badge-check,eye,lock,server,user-round,building-2,factory,hammer,wrench,menu,x,play,gauge,sliders-horizontal,arrow-up-right}.svg",
  { query: "?raw", import: "default", eager: true },
) as Record<string, string>;

const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);

const svg = raw
  .replace(/<!--[\s\S]*?-->/, "")
  .replace('width="24"', `width="${size}"`)
  .replace('height="24"', `height="${size}"`)
  .replace('stroke-width="2"', `stroke-width="${strokeWidth}"`)
  .replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true"`);
---

<Fragment set:html={svg} />
