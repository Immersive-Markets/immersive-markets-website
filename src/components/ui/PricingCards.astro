---
import Icon from "../Icon.astro";
import { tiers } from "../../data/pricing";

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}
const { ctaHref = "/gespraech", ctaLabel = "Gespräch anfragen" } = Astro.props;
---

<div class="mx-auto grid max-w-[1180px] items-start gap-5 md:grid-cols-3">
  {tiers.map((tier) => (
    <div
      class:list={[
        "relative flex flex-col rounded-[28px] p-7 md:p-8",
        tier.featured ? "bg-featured border border-lime-300 shadow-[0_2px_24px_rgba(116,148,14,.18)]" : "card",
      ]}
    >
      <div class="flex items-center justify-between gap-3">
        <h3 class="m-0 text-[26px] font-semibold tracking-[-0.02em]">{tier.name}</h3>
        {tier.featured && (
          <span class="rounded-[8px] bg-lime-300 px-2.5 py-1 text-[11px] font-semibold tracking-wide whitespace-nowrap text-ink uppercase">Empfohlen</span>
        )}
      </div>
      <p class="mt-1 mb-6 text-[15px] text-body">{tier.saeulen}</p>
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="text-[40px] leading-none font-semibold tracking-[-0.03em] whitespace-nowrap lg:text-[44px]">{tier.preis}</span>
        <span class="text-[14px] whitespace-nowrap text-muted">/ Monat</span>
      </div>
      <a href={ctaHref} class="btn btn-dark mt-7 w-full">{ctaLabel}</a>
      <div class="mt-7 border-t border-black/[.07] pt-6">
        <div class="mb-3 text-[14px] font-medium text-muted">Enthalten …</div>
        <ul class="flex flex-col gap-3 text-[15px]">
          {tier.enthalten.map((f) => (
            <li class="flex gap-2.5">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-lime-600" strokeWidth={2.25} />{f}
            </li>
          ))}
        </ul>
      </div>
    </div>
  ))}
</div>
