---
import EmailCta from "./EmailCta.astro";

interface Props {
  title?: string;
}
const { title = "Machen Sie Ihr Unternehmen bereit<br />für die nächste Generation." } = Astro.props;
---

<section class="relative overflow-hidden px-5 pt-20 pb-24 md:px-8 md:pt-28 md:pb-32">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_50%_100%,rgba(201,242,74,.55),transparent_70%),linear-gradient(180deg,#fff_0%,#f8fdeb_60%,#e9f8b8_100%)]"></div>
  <div class="mx-auto max-w-[1180px]">
    <h2 class="h-section m-0 text-center text-balance" set:html={title} />

    <div class="mt-12 grid gap-5 lg:grid-cols-[1.45fr_1fr]">
      <div class="glass rounded-[28px] p-7 md:p-10">
        <span class="inline-flex rounded-[8px] bg-lime-300 px-2.5 py-1 text-[13px] font-semibold text-ink">Erstgespräch · 30 Minuten per Video</span>
        <h3 class="mt-5 mb-4 text-[28px] leading-tight font-semibold tracking-[-0.02em]">Sichern Sie sich Ihr persönliches Gespräch</h3>
        <ol class="mb-7 flex flex-col gap-1.5 text-[16px] text-body">
          <li>1. Sie erzählen, wo Ihr Betrieb gerade steht</li>
          <li>2. Wir klären, welche Säule zuerst dran ist</li>
          <li>3. Sie wissen, ob eine Partnerschaft passt</li>
        </ol>
        <EmailCta />
        <p class="mt-3 mb-0 text-[14px] text-muted">Im nächsten Schritt nennen Sie kurz Ihr Anliegen und passende Termine.</p>
      </div>
      <div class="glass flex flex-col rounded-[28px] p-7 md:p-10">
        <span class="inline-flex self-start rounded-[8px] bg-white px-2.5 py-1 text-[13px] font-semibold text-ink shadow-sm">So geht es weiter</span>
        <h3 class="mt-5 mb-4 text-[28px] leading-tight font-semibold tracking-[-0.02em]">Nach Ihrer Anfrage</h3>
        <ol class="mb-7 flex flex-col gap-1.5 text-[16px] text-body">
          <li>1. Ich lese Ihr Anliegen persönlich</li>
          <li>2. Ich melde mich mit einem Terminvorschlag</li>
          <li>3. Wir sprechen 30 Minuten per Video</li>
        </ol>
        <p class="mt-auto mb-0 text-[15px] text-body">
          Lieber direkt? <a href="mailto:info@immersive-markets.de" class="font-semibold text-lime-700 hover:text-lime-900">info@immersive-markets.de</a>
        </p>
      </div>
    </div>
  </div>
</section>
