---
import Icon from "../Icon.astro";

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="mx-auto flex max-w-[860px] flex-col gap-3">
  {items.map((it) => (
    <details class="faq card group rounded-[20px] px-6">
      <summary class="flex items-center justify-between gap-4 py-5 text-[17px] font-semibold">
        <span>{it.q}</span>
        <Icon name="chevron-down" size={20} class="shrink-0 text-muted transition-transform group-open:rotate-180" />
      </summary>
      <p class="m-0 pb-6 text-[16px] leading-relaxed text-body">{it.a}</p>
    </details>
  ))}
</div>
