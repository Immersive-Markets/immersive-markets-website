---
import { pillars } from "../data/pillars";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();

const spalten = [
  {
    titel: "Leistungen",
    links: [{ label: "Übersicht", href: "/leistungen" }, ...pillars.map((p) => ({ label: p.name, href: `/leistungen/${p.id}` }))],
  },
  {
    titel: "Angebot",
    links: [
      { label: "Zusammenarbeit", href: "/zusammenarbeit" },
      { label: "Preise", href: "/preise" },
      { label: "Selbstchecks", href: "/checks" },
      { label: "Für Partner", href: "/partner" },
    ],
  },
  {
    titel: "Mehr",
    links: [
      { label: "KI-Transparenz", href: "/ki-transparenz" },
      { label: "Über mich", href: "/ueber-mich" },
    ],
  },
  {
    titel: "Rechtliches",
    links: [
      { label: "Impressum", href: "/impressum" },
      { label: "Datenschutz", href: "/datenschutz" },
      { label: "AGB", href: "/agb" },
    ],
  },
  {
    titel: "Kontakt",
    links: [
      { label: "Gespräch anfragen", href: "/gespraech" },
      { label: "info@immersive-markets.de", href: "mailto:info@immersive-markets.de" },
    ],
  },
];
---

<footer class="bg-white px-3 pt-16 md:px-5">
  <div class="bg-forest relative mx-auto max-w-[1400px] overflow-hidden rounded-t-[32px] px-6 pt-14 text-white md:px-12">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_3fr]">
      <div>
        <Logo tone="light" />
        <p class="mt-6 mb-0 max-w-[260px] text-[24px] leading-[1.15] font-semibold tracking-[-0.02em] text-lime-300">
          Bereit für die nächste Generation.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
        {spalten.map((s) => (
          <div>
            <div class="mb-4 text-[14px] font-semibold text-white/45">{s.titel}</div>
            <ul class="flex flex-col gap-2.5 text-[14px]">
              {s.links.map((l) => (
                <li><a href={l.href} class="break-words text-white/85 transition-colors hover:text-lime-300">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-6 text-[13px] text-white/45">
      <span>© {year} Immersive Markets · Felix Binder</span>
      <span>Remote-first vom Bodensee</span>
    </div>

    <div aria-hidden="true" class="pointer-events-none mt-4 -mb-[0.2em] select-none text-[clamp(44px,9.2vw,132px)] leading-[0.85] font-semibold tracking-[-0.05em] whitespace-nowrap text-white">
      Immersive Markets
    </div>
  </div>
</footer>
