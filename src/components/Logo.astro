---
interface Props {
  tone?: "dark" | "light";
  class?: string;
}
const { tone = "dark", class: cls = "" } = Astro.props;
---

<a
  href="/"
  class:list={[
    "inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-[21px] font-semibold tracking-[-0.03em]",
    tone === "dark" ? "text-ink" : "text-white",
    cls,
  ]}
  aria-label="Immersive Markets — Startseite"
>
  <span class="size-[18px] rounded-[6px] bg-lime-300 shadow-[inset_0_1px_1px_rgba(255,255,255,.7),inset_0_0_6px_rgba(255,255,255,.4)]"></span>
  Immersive Markets
</a>
