---
import Icon from "../Icon.astro";
import EmailCta from "../ui/EmailCta.astro";
import { pillars } from "../../data/pillars";

type Status = "Erledigt" | "In Arbeit" | "Geplant";
const roadmap: Record<string, { monat: string; tasks: { t: string; s: Status }[] }[]> = {
  mitarbeiter: [
    { monat: "Monat 1", tasks: [{ t: "Karriereseite neu aufsetzen", s: "In Arbeit" }, { t: "Stellenanzeigen für die Gen Z umschreiben", s: "In Arbeit" }] },
    { monat: "Monat 2", tasks: [{ t: "Stimmen aus dem Team sammeln", s: "Geplant" }, { t: "Einarbeitung als digitale Checkliste", s: "Geplant" }] },
    { monat: "Monat 3", tasks: [{ t: "Recruiting-Kampagne testen", s: "Geplant" }] },
  ],
  kunden: [
    { monat: "Monat 1", tasks: [{ t: "Website-Check & Prioritäten", s: "Erledigt" }, { t: "Startseite neu texten", s: "In Arbeit" }] },
    { monat: "Monat 2", tasks: [{ t: "LinkedIn-Profil der Geschäftsführung", s: "Geplant" }, { t: "Referenzen sichtbar machen", s: "Geplant" }] },
    { monat: "Monat 3", tasks: [{ t: "Anfragen direkt ins CRM", s: "Geplant" }] },
  ],
  prozesse: [
    { monat: "Monat 1", tasks: [{ t: "Alle Excel-Listen erfassen", s: "Erledigt" }, { t: "Passendes CRM auswählen", s: "In Arbeit" }] },
    { monat: "Monat 2", tasks: [{ t: "Kundendaten übernehmen", s: "Geplant" }, { t: "Angebotsvorlage automatisieren", s: "Geplant" }] },
    { monat: "Monat 3", tasks: [{ t: "Wiedervorlagen automatisch", s: "Geplant" }] },
  ],
  ki: [
    { monat: "Monat 1", tasks: [{ t: "KI-Potenzialanalyse", s: "Erledigt" }, { t: "KI-Regeln für das Team", s: "In Arbeit" }] },
    { monat: "Monat 2", tasks: [{ t: "Schulung: KI im Büroalltag", s: "Geplant" }, { t: "Assistent für Angebotsentwürfe", s: "Geplant" }] },
    { monat: "Monat 3", tasks: [{ t: "Wissensdatenbank fürs Team", s: "Geplant" }] },
  ],
};

const chip: Record<Status, string> = {
  Erledigt: "bg-lime-300 text-ink",
  "In Arbeit": "bg-amber-100 text-amber-900",
  Geplant: "bg-black/[.05] text-body",
};

const sidebar = [
  { label: "Übersicht", icon: "layout-dashboard", active: false },
  { label: "Roadmap", icon: "list-checks", active: true },
  { label: "Termine", icon: "calendar", active: false },
  { label: "Reports", icon: "file-text", active: false },
  { label: "Lernbibliothek", icon: "graduation-cap", active: false },
];
---

<section class="relative overflow-hidden px-5 pt-14 md:px-8 md:pt-20">
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-[78%] bg-[radial-gradient(60%_60%_at_50%_75%,rgba(201,242,74,.85),transparent_72%),radial-gradient(40%_45%_at_8%_90%,rgba(182,224,44,.55),transparent_70%),radial-gradient(40%_45%_at_92%_90%,rgba(226,245,166,.95),transparent_70%)]"></div>

  <div class="mx-auto max-w-[1180px] text-center">
    <div class="glass mx-auto mb-7 inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] font-medium">
      <span class="size-2 rounded-full bg-lime-400"></span>
      Für Nachfolgerinnen und Nachfolger im Mittelstand
    </div>
    <h1 class="h-display m-0 text-[clamp(2.25rem,6.4vw,5.5rem)] leading-[1.02] tracking-[-0.035em]">Führen Sie Ihr <br class="hidden md:inline" />Traditions&shy;unternehmen <br class="hidden md:inline" />in die digitale Zukunft</h1>
    <p class="lead mx-auto mt-7 max-w-[760px] text-pretty">
      Mitarbeiter, Kunden, Prozesse und KI: Ihr Unternehmen nutzt mit hoher Wahrscheinlichkeit noch nicht alle Möglichkeiten, die das 21. Jahrhundert bietet. Lassen Sie uns das gemeinsam ändern!
    </p>
    <div class="mt-8 flex justify-center">
      <EmailCta />
    </div>
    <p class="mt-6 text-[15px] font-medium text-body">
      Persönlich mit Felix Binder · Remote-first
    </p>
  </div>

  <div class="mx-auto mt-14 max-w-[1240px]" data-tabs>
    <div class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Beispiel-Roadmap nach Säule">
      {pillars.map((p, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${p.id}`}
          aria-controls={`panel-${p.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          data-tab={p.id}
          class="tab-btn inline-flex h-11 items-center gap-2 rounded-full px-4 text-[15px] font-semibold transition-colors"
        >
          <Icon name={p.icon} size={17} />{p.name}
        </button>
      ))}
    </div>

    <div class="glass mt-6 rounded-t-[32px] border-b-0 p-2 pb-0 md:p-3 md:pb-0">
      <div class="overflow-hidden rounded-t-[24px] bg-white/85 md:grid md:grid-cols-[220px_1fr]">
        <aside class="hidden border-r border-line bg-lime-50/60 p-4 md:block">
          <div class="mb-6 flex items-center gap-2.5">
            <span class="flex size-8 items-center justify-center rounded-[9px] bg-lime-300 text-[13px] font-bold">IM</span>
            <span class="text-[14px] font-semibold">Kundenportal</span>
          </div>
          <ul class="flex flex-col gap-1 text-[14px]">
            {sidebar.map((s) => (
              <li class:list={["flex items-center gap-2.5 rounded-[10px] px-2.5 py-2", s.active ? "bg-lime-200/70 font-semibold text-ink" : "text-body"]}>
                <Icon name={s.icon} size={16} />{s.label}
              </li>
            ))}
          </ul>
          <div class="mt-6 rounded-[14px] border border-line bg-white p-3 text-left">
            <div class="text-[12px] text-muted">Nächster Termin</div>
            <div class="mt-0.5 text-[13px] font-semibold">Strategie-Call</div>
            <div class="text-[12px] text-muted">Donnerstag, 10:00 Uhr</div>
          </div>
        </aside>

        <div class="p-4 text-left md:p-7">
          <div class="mb-6 flex items-center justify-between gap-3">
            <div class="flex h-9 max-w-[320px] flex-1 items-center gap-2 rounded-full bg-black/[.04] px-3.5 text-[13px] text-muted">
              <Icon name="search" size={15} /> Suchen
            </div>
            <span class="rounded-full border border-line bg-white px-3 py-1 text-[12px] font-medium text-muted">Beispiel</span>
          </div>

          {pillars.map((p, i) => (
            <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-panel={p.id} hidden={i !== 0}>
              <div class="text-[13px] text-muted">90-Tage-Roadmap</div>
              <h2 class="mt-1 mb-6 text-[26px] font-semibold tracking-[-0.02em] md:text-[32px]">Säule {p.name}</h2>
              <div class="grid gap-4 pb-8 md:grid-cols-3">
                {roadmap[p.id].map((col) => (
                  <div class="rounded-[18px] bg-black/[.025] p-3">
                    <div class="mb-3 px-1 text-[13px] font-semibold text-body">{col.monat}</div>
                    <div class="flex flex-col gap-2.5">
                      {col.tasks.map((task) => (
                        <div class="rounded-[14px] border border-line bg-white p-3.5 shadow-[0_1px_2px_rgba(0,0,0,.04)]">
                          <div class="text-[14px] leading-snug font-medium">{task.t}</div>
                          <span class:list={["mt-2.5 inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold", chip[task.s]]}>{task.s}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tab-btn {
    background: rgba(255, 255, 255, 0.7);
    color: var(--color-ink);
    box-shadow:
      inset 0 0.5px 0 rgba(255, 255, 255, 0.6),
      0 0.5px 2px rgba(0, 0, 0, 0.08),
      0 2px 12px -4px rgba(0, 0, 0, 0.1);
  }
  .tab-btn:hover {
    background: #fff;
  }
  .tab-btn[aria-selected="true"] {
    background: var(--color-forest-900);
    color: #fff;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.2),
      inset 0 0 10px rgba(201, 242, 74, 0.15);
  }
  .tab-btn[aria-selected="true"] :global(svg) {
    color: var(--color-lime-300);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const select = (id: string) => {
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t) => t.addEventListener("click", () => select(t.dataset.tab!)));
  });
</script>
