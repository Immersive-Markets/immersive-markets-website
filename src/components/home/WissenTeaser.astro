---
import Icon from "../Icon.astro";
import SectionHead from "../ui/SectionHead.astro";

const kiSchritte = [
  { schritt: "Recherche & Themen", wer: "KI-gestützt", ki: true },
  { schritt: "Erste Entwürfe", wer: "KI-gestützt", ki: true },
  { schritt: "Fakten- & Markencheck", wer: "Mensch", ki: false },
  { schritt: "Freigabe", wer: "Mensch", ki: false },
];
const partnerSchritte = ["Sie stellen den Kontakt her", "Ich führe das Erstgespräch", "Sie bleiben informiert"];
---

<section class="px-5 py-24 md:px-8 md:py-32">
  <SectionHead eyebrow="Wissen" title="Der Mittelstand verändert sich.<br />Hier finden Sie Orientierung." lead="Hintergründe, Spielregeln und Leitfäden, sortiert nach den vier Säulen.">
    <a href="/wissen" class="link-arrow mt-5 text-[16px]">Zum Wissensbereich <Icon name="arrow-right" size={16} /></a>
  </SectionHead>

  <div class="mx-auto mt-12 grid max-w-[1240px] gap-5 lg:grid-cols-2">
    <a href="/ki-transparenz" class="group flex flex-col overflow-hidden rounded-[28px] bg-[linear-gradient(160deg,#f8fdeb,#eefad0)] p-7 md:p-9">
      <h3 class="m-0 flex items-center gap-2 text-[20px] font-semibold tracking-[-0.01em] text-lime-800">
        KI-Transparenz <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
      </h3>
      <p class="mt-2 mb-8 max-w-[440px] text-[16px] text-body">Wo KI bei mir arbeitet, wo ein Mensch prüft und wie das gekennzeichnet wird.</p>
      <div class="glass mt-auto rounded-[20px] p-4">
        {kiSchritte.map((s, i) => (
          <div class:list={["flex items-center justify-between py-3", i > 0 && "border-t border-black/[.06]"]}>
            <span class="text-[15px] font-medium">{s.schritt}</span>
            <span class:list={["rounded-full px-2.5 py-0.5 text-[12px] font-semibold", s.ki ? "bg-lime-200 text-lime-900" : "bg-forest-900 text-white"]}>{s.wer}</span>
          </div>
        ))}
      </div>
    </a>

    <a href="/partner" class="group flex flex-col overflow-hidden rounded-[28px] bg-[linear-gradient(160deg,#f6f6f4,#ecece6)] p-7 md:p-9">
      <h3 class="m-0 flex items-center gap-2 text-[20px] font-semibold tracking-[-0.01em] text-lime-800">
        Für Partner <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
      </h3>
      <p class="mt-2 mb-8 max-w-[440px] text-[16px] text-body">Für Steuerberatung, Sparkassen, Volksbanken und Kammern: Empfehlen Sie Ihren Mandanten eine Lösung für die Nachfolge.</p>
      <div class="glass mt-auto rounded-[20px] p-4">
        {partnerSchritte.map((s, i) => (
          <div class:list={["flex items-center gap-3 py-3", i > 0 && "border-t border-black/[.06]"]}>
            <span class="flex size-7 items-center justify-center rounded-full bg-lime-300 text-[13px] font-semibold">{i + 1}</span>
            <span class="text-[15px] font-medium">{s}</span>
          </div>
        ))}
      </div>
    </a>
  </div>
</section>
