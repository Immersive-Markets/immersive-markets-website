---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/ui/PageHero.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import CtaDuo from "../../components/ui/CtaDuo.astro";
import { pillars } from "../../data/pillars";

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { id: p.id }, props: { pillar: p } }));
}

const { pillar } = Astro.props;
const others = pillars.filter((p) => p.id !== pillar.id);
---

<Layout title={`${pillar.name} — Leistungen — Immersive Markets`} description={`${pillar.frage} ${pillar.tagline}.`}>
  <SiteHeader />
  <main>
    <PageHero eyebrow={pillar.name} crumbs={[{ label: "Leistungen", href: "/leistungen" }]} title={pillar.frage} lead={pillar.intro}>
      <ul class="mt-8 flex flex-wrap justify-center gap-2">
        {pillar.themen.map((t) => <li class="glass rounded-full px-3.5 py-1.5 text-[14px] font-medium">{t}</li>)}
      </ul>
    </PageHero>

    <section id="themen" class="px-5 py-20 md:px-8 md:py-28">
      <SectionHead eyebrow="Typische Probleme" title="Kommt Ihnen das bekannt vor?" />
      <div class="mx-auto mt-12 grid max-w-[1180px] gap-5 md:grid-cols-3">
        {pillar.probleme.map((pr, i) => (
          <div class="card p-7">
            <span class="flex size-9 items-center justify-center rounded-full bg-lime-300 text-[14px] font-semibold">{i + 1}</span>
            <h3 class="h-card mt-5 mb-2">{pr.titel}</h3>
            <p class="m-0 text-[16px] text-body">{pr.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="px-3 md:px-5">
      <div class="bg-forest mx-auto grid max-w-[1400px] items-center gap-10 rounded-[32px] px-6 py-16 md:grid-cols-[1fr_.9fr] md:px-14 md:py-20">
        <div>
          <div class="eyebrow mb-4 text-white/60">Einstieg ohne Verpflichtung</div>
          <h2 class="h-section m-0 text-white">{pillar.check.hook}</h2>
          <p class="lead mt-5 text-white/70">Der {pillar.check.name} gibt Ihnen eine erste, ehrliche Einschätzung — kostenlos und unverbindlich.</p>
        </div>
        <div class="glass rounded-[24px] p-7">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2 text-[15px] font-semibold text-lime-700"><Icon name={pillar.icon} size={18} />{pillar.check.name}</span>
            {pillar.check.status === "bald" && <span class="rounded-[6px] bg-lime-300 px-2 py-0.5 text-[12px] font-semibold">Bald</span>}
          </div>
          <p class="mt-3 mb-6 text-[16px] text-body">Ein Klick pro Frage, ehrliches Ergebnis, konkrete nächste Schritte.</p>
          <a href={`/checks/${pillar.id}`} class="btn btn-dark">Zum Check</a>
        </div>
      </div>
    </section>

    <section class="px-5 py-24 md:px-8 md:py-28">
      <SectionHead title="Die anderen Säulen">
        <a href="/preise" class="link-arrow mt-4 text-[16px]">Preise ansehen <Icon name="arrow-right" size={16} /></a>
      </SectionHead>
      <div class="mx-auto mt-12 grid max-w-[1180px] gap-5 md:grid-cols-3">
        {others.map((p) => (
          <a href={`/leistungen/${p.id}`} class="card group flex flex-col p-7 transition-transform hover:-translate-y-0.5">
            <span class="flex size-10 items-center justify-center rounded-[12px] bg-lime-100 text-lime-800"><Icon name={p.icon} size={20} /></span>
            <h3 class="h-card mt-5 mb-1">{p.name}</h3>
            <p class="m-0 mb-6 text-[15px] text-body">{p.frage}</p>
            <span class="link-arrow mt-auto text-[15px]">Mehr erfahren <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </section>

    <CtaDuo />
  </main>
  <SiteFooter />
</Layout>
