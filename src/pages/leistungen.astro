---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import CtaDuo from "../components/ui/CtaDuo.astro";
import { pillars } from "../data/pillars";

const rolle = [
  { icon: "user-round", titel: "Verantwortung wie intern", text: "Ich übernehme Digitalisierung, Modernisierung und Wachstum — so, wie es eine interne Stelle täte." },
  { icon: "workflow", titel: "Beratung und Umsetzung", text: "Kein Konzept für die Schublade: Was wir beschließen, setze ich auch um." },
  { icon: "timer", titel: "Nur so viel, wie Sie brauchen", text: "Remote-first und monatlich — statt einer Vollzeitstelle, die Sie erst besetzen müssten." },
];
---

<Layout title="Leistungen — Immersive Markets" description="Der externe Modernisierungspartner für Traditionsunternehmen: vier Säulen, ein fester Ansprechpartner, Beratung und Umsetzung aus einer Hand.">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Leistungen"
      title="Ein externer Modernisierungspartner —<br />keine Agentur, kein Berater-Tag."
      lead="Vier Säulen, ein fester Ansprechpartner. Sie entscheiden, welche Säulen aktiv sind, und können das jedes Quartal anpassen."
    >
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/gespraech" class="btn btn-dark">Gespräch anfragen</a>
        <a href="/preise" class="btn btn-light">Preise ansehen</a>
      </div>
    </PageHero>

    <section class="px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto grid max-w-[1180px] gap-5 md:grid-cols-3">
        {rolle.map((r) => (
          <div class="card p-7">
            <span class="flex size-10 items-center justify-center rounded-[12px] bg-lime-100 text-lime-800"><Icon name={r.icon} size={20} /></span>
            <h2 class="h-card mt-5 mb-2">{r.titel}</h2>
            <p class="m-0 text-[16px] text-body">{r.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-forest px-5 py-24 md:px-8 md:py-28">
      <SectionHead tone="light" eyebrow="Die vier Säulen" title="Alles hängt an vier Säulen" lead="Jeder Check und jedes Umsetzungsthema gehört zu genau einer davon." />
      <div class="mx-auto mt-14 grid max-w-[1180px] gap-5 md:grid-cols-2">
        {pillars.map((p) => (
          <a href={`/leistungen/${p.id}`} class="group flex flex-col rounded-[28px] bg-white p-7 transition-transform hover:-translate-y-0.5 md:p-9">
            <div class="flex items-center gap-3">
              <span class="flex size-10 items-center justify-center rounded-[12px] bg-lime-100 text-lime-800"><Icon name={p.icon} size={20} /></span>
              <span class="text-[15px] font-semibold text-lime-700">{p.name}</span>
            </div>
            <h3 class="mt-5 mb-3 text-[26px] leading-tight font-semibold tracking-[-0.02em]">{p.frage}</h3>
            <p class="m-0 mb-6 text-[16px] text-body">{p.intro}</p>
            <ul class="mb-8 flex flex-wrap gap-2">
              {p.themen.map((t) => <li class="rounded-full bg-black/[.04] px-3 py-1 text-[13px] font-medium">{t}</li>)}
            </ul>
            <span class="link-arrow mt-auto text-[15px]">Mehr zur Säule {p.name} <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="px-5 py-24 md:px-8 md:py-28">
      <SectionHead eyebrow="Klare Grenzen" title="Was nicht dabei ist" />
      <div class="mx-auto mt-12 grid max-w-[1000px] gap-5 md:grid-cols-2">
        <div class="rounded-[28px] bg-surface p-8">
          <Icon name="shield-check" size={22} class="text-lime-700" />
          <h3 class="h-card mt-4 mb-2">App-Entwicklung &amp; IT-Sicherheit</h3>
          <p class="m-0 text-[16px] text-body">Biete ich nicht selbst an. Dafür vermittle ich spezialisierte Partner aus meinem Netzwerk — Sie haben trotzdem einen Ansprechpartner.</p>
        </div>
        <div class="rounded-[28px] bg-surface p-8">
          <Icon name="file-text" size={22} class="text-lime-700" />
          <h3 class="h-card mt-4 mb-2">Content aus dem Nichts</h3>
          <p class="m-0 text-[16px] text-body">Ich arbeite mit Material, das Sie liefern, und reichere es bei Bedarf mit KI an — gekennzeichnet, wo das nötig ist. Mehr unter <a href="/ki-transparenz" class="font-semibold text-lime-700 underline-offset-2 hover:underline">KI-Transparenz</a>.</p>
        </div>
      </div>
    </section>

    <CtaDuo title="Welche Säule ist bei Ihnen<br />zuerst dran?" />
  </main>
  <SiteFooter />
</Layout>
