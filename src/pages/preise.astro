---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import PricingCards from "../components/ui/PricingCards.astro";
import FaqList from "../components/ui/FaqList.astro";
import CtaDuo from "../components/ui/CtaDuo.astro";
import { nichtEnthalten } from "../data/pricing";
import { faqPreise } from "../data/faq";
---

<Layout title="Preise — Immersive Markets" description="Drei Pakete, öffentlich und vollständig: Fokus, Wachstum und Partner. Ab 1.490 € netto im Monat, mindestens 3 Monate Laufzeit, danach monatlich kündbar.">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Pakete & Preise"
      title="Vollständig offen.<br />Keine Überraschungen."
      lead="Sie kaufen eine Rolle — den externen Digitalchef — als monatliche Partnerschaft. Die drei Pakete unterscheiden sich nur darin, wie viele Säulen gleichzeitig aktiv sind."
    />

    <section class="-mt-12 px-5 pb-24 md:px-8">
      <PricingCards />
      <p class="mt-8 text-center text-[14px] text-muted">Alle Preise netto. Hinweise zur Umsatzsteuer finden Sie in den <a href="/agb" class="underline underline-offset-2 hover:text-ink">AGB</a>.</p>
    </section>

    <section class="px-5 pb-24 md:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-5 md:grid-cols-2">
        <div class="card p-8">
          <Icon name="calendar" size={22} class="text-lime-700" />
          <h2 class="h-card mt-4 mb-3">Laufzeit</h2>
          <p class="m-0 text-[16px] leading-relaxed text-body">
            Mindestens 3 Monate, danach monatlich kündbar. Bei 12 Monaten fester Laufzeit ist ein Monat gratis. Die aktiven Säulen dürfen jedes Quartal wechseln — was umgesetzt wird, steht in der gemeinsamen Roadmap im Kundenportal.
          </p>
        </div>
        <div class="card p-8">
          <Icon name="x" size={22} class="text-lime-700" />
          <h2 class="h-card mt-4 mb-3">Nicht enthalten</h2>
          <ul class="flex flex-col gap-2.5 text-[16px] text-body">
            {nichtEnthalten.map((n) => <li class="flex gap-2.5"><span class="text-muted">–</span>{n}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="px-3 md:px-5">
      <div class="bg-featured mx-auto max-w-[1400px] rounded-[32px] border border-lime-200 px-6 py-16 text-center md:py-20">
        <span class="inline-flex rounded-[8px] bg-lime-300 px-2.5 py-1 text-[13px] font-semibold">Pilotangebot</span>
        <h2 class="h-section mx-auto mt-5 max-w-[760px]">Die ersten 5 Kunden: 3 Monate zum halben Preis.</h2>
        <p class="lead mx-auto mt-5 max-w-[620px]">Im Tausch gegen eine Case Study mit echten Zahlen und ein Testimonial. Das Angebot ist schriftlich befristet — sprechen Sie mich im Erstgespräch darauf an.</p>
        <a href="/gespraech" class="btn btn-dark mt-8">Gespräch buchen</a>
      </div>
    </section>

    <section id="faq" class="px-5 pt-24 md:px-8 md:pt-28">
      <SectionHead eyebrow="Preis-FAQ" title="Häufige Fragen zum Preis" class="mb-12" />
      <FaqList items={faqPreise} />
    </section>

    <CtaDuo />
  </main>
  <SiteFooter />
</Layout>
