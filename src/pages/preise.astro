---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import PricingCards from "../components/ui/PricingCards.astro";
import FaqList from "../components/ui/FaqList.astro";
import CtaDuo from "../components/ui/CtaDuo.astro";
import { tiers, vergleich, fundament, vorhabenBeispiele, nichtEnthalten } from "../data/pricing";
import { faqPreise } from "../data/faq";

const regeln = [
  { icon: "calendar", titel: "2 bis 6 Wochen pro Vorhaben", text: "Größeres teilen wir in Etappen. So sehen Sie regelmäßig, was fertig ist." },
  { icon: "list-checks", titel: "Wartet ein Vorhaben auf Sie, zieht das nächste vor", text: "Fehlt Material oder eine Freigabe, geht es mit dem nächsten Vorhaben weiter. Sie bezahlen keinen Stillstand." },
  { icon: "eye", titel: "Keine Stundenzettel", text: "Im Kundenportal sehen Sie, welche Vorhaben laufen, welche fertig sind und was als Nächstes kommt." },
];
---

<Layout title="Preise — Immersive Markets" description="Drei Pakete, öffentlich und vollständig: Fokus, Wachstum und Transformation. Abgerechnet wird nach Vorhaben, nie nach Stunden. Ab 1.490 € im Monat.">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Pakete & Preise"
      title="Vollständig offen.<br />Keine Überraschungen."
      lead="Sie buchen einen externen Modernisierungspartner als monatliche Partnerschaft. Die Pakete unterscheiden sich darin, wie viele Vorhaben gleichzeitig laufen. Abgerechnet wird nie nach Stunden."
    />

    <section class="-mt-12 px-5 pb-24 md:px-8">
      <PricingCards />
      <p class="mt-8 text-center text-[14px] text-muted">Kein Ausweis der Umsatzsteuer gem. § 19 UStG (Kleinunternehmerregelung). Details in den <a href="/agb" class="underline underline-offset-2 hover:text-ink">AGB</a>.</p>
    </section>

    <section id="vorhaben" class="px-3 md:px-5">
      <div class="bg-forest mx-auto max-w-[1400px] rounded-[32px] px-5 py-20 md:px-8 md:py-24">
        <SectionHead
          tone="light"
          eyebrow="Das Vorhaben-Modell"
          title="Bezahlt wird, was fertig wird."
          lead="Ein Vorhaben ist ein abgegrenztes Stück Arbeit mit festem Ergebnis. Ist es fertig, rückt das nächste aus Ihrer Roadmap nach, aus jeder der vier Säulen."
        />
        <div class="mx-auto mt-12 grid max-w-[1080px] gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {vorhabenBeispiele.map((v) => (
            <a href={v.href} class="glass-dark group flex flex-col rounded-[22px] p-6 transition-colors hover:bg-white/15">
              <span class="text-[13px] font-semibold text-lime-300">Beispiel · {v.saeule}</span>
              <span class="mt-2 mb-5 text-[17px] leading-snug font-semibold text-white">{v.titel}</span>
              <span class="mt-auto inline-flex items-center gap-1.5 text-[14px] text-white/65 group-hover:text-white">Zum Thema <Icon name="arrow-right" size={15} /></span>
            </a>
          ))}
        </div>
        <div class="mx-auto mt-10 grid max-w-[1080px] gap-4 md:grid-cols-3">
          {regeln.map((r) => (
            <div class="rounded-[22px] border border-white/10 p-6">
              <Icon name={r.icon} size={20} class="text-lime-300" />
              <div class="mt-3 text-[16px] font-semibold text-white">{r.titel}</div>
              <div class="mt-1.5 text-[15px] text-white/65">{r.text}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="vergleich" class="px-5 py-24 md:px-8 md:py-28">
      <SectionHead eyebrow="Im Vergleich" title="Gleiches Fundament, anderes Tempo" />
      <div class="mx-auto mt-12 max-w-[920px] rounded-[24px] bg-[linear-gradient(160deg,#f8fdeb,#eefad0)] p-6 md:p-8">
        <div class="eyebrow mb-5">In jedem Paket: das Fundament</div>
        <div class="grid gap-5 sm:grid-cols-2">
          {fundament.map((f) => (
            <div class="flex gap-3.5">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-white text-lime-800"><Icon name={f.icon} size={18} /></span>
              <div>
                <div class="text-[16px] font-semibold">{f.titel}</div>
                <div class="mt-0.5 text-[15px] text-body">{f.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="mx-auto mt-5 max-w-[920px] overflow-x-auto rounded-[24px] border border-line">
        <table class="w-full border-collapse text-left text-[13px] sm:text-[14px] md:text-[15px] hyphens-auto">
          <thead>
            <tr class="bg-surface">
              <th class="p-2 font-medium text-muted sm:p-3 md:p-4"><span class="sr-only">Leistung</span></th>
              {tiers.map((t) => (
                <th class:list={["p-2 text-center font-semibold break-words sm:p-3 md:p-4", t.featured && "bg-lime-100"]}>{t.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {vergleich.map((z) => (
              <tr class="border-t border-line">
                <th class="p-2 font-medium sm:p-3 md:p-4">{z.label}</th>
                {z.werte.map((w, i) => (
                  <td class:list={["p-2 text-center sm:p-3 md:p-4", tiers[i].featured && "bg-lime-50"]}>
                    {w === true ? (
                      <Icon name="check" size={18} class="mx-auto text-lime-600" strokeWidth={2.25} />
                    ) : w === false ? (
                      <span class="text-muted">–</span>
                    ) : (
                      w
                    )}
                  </td>
                ))}
              </tr>
            ))}
            <tr class="border-t border-line bg-surface">
              <th class="p-2 font-semibold sm:p-3 md:p-4">Preis pro Monat</th>
              {tiers.map((t) => (
                <td class="p-2 text-center font-semibold whitespace-nowrap sm:p-3 md:p-4">{t.preis}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="px-5 pb-24 md:px-8">
      <div class="mx-auto grid max-w-[1180px] gap-5 md:grid-cols-2">
        <div class="card p-8">
          <Icon name="calendar" size={22} class="text-lime-700" />
          <h2 class="h-card mt-4 mb-3">Laufzeit</h2>
          <p class="m-0 text-[16px] leading-relaxed text-body">
            Mindestens 3 Monate, danach monatlich kündbar. Bei 12 Monaten fester Laufzeit ist ein Monat gratis. Welche Vorhaben als Nächstes kommen, legen wir gemeinsam in der Roadmap im Kundenportal fest.
          </p>
        </div>
        <div class="card p-8">
          <Icon name="x" size={22} class="text-lime-700" />
          <h2 class="h-card mt-4 mb-3">Nicht enthalten</h2>
          <ul class="flex flex-col gap-2.5 text-[16px] text-body">
            {nichtEnthalten.map((n) => <li class="flex gap-2.5"><span class="text-muted">–</span>{n}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="px-3 md:px-5">
      <div class="bg-featured mx-auto max-w-[1400px] rounded-[32px] border border-lime-200 px-6 py-16 text-center md:py-20">
        <span class="inline-flex rounded-[8px] bg-lime-300 px-2.5 py-1 text-[13px] font-semibold">Pilotangebot</span>
        <h2 class="h-section mx-auto mt-5 max-w-[760px]">Die ersten 5 Kunden: 3 Monate zum halben Preis.</h2>
        <p class="lead mx-auto mt-5 max-w-[620px]">Im Tausch gegen eine Case Study mit echten Zahlen und ein Testimonial. Das Angebot ist schriftlich befristet. Sprechen Sie mich im Erstgespräch darauf an.</p>
        <a href="/gespraech" class="btn btn-dark mt-8">Gespräch anfragen</a>
      </div>
    </section>

    <section id="faq" class="px-5 pt-24 md:px-8 md:pt-28">
      <SectionHead eyebrow="Preis-FAQ" title="Häufige Fragen zum Preis" class="mb-12" />
      <FaqList items={faqPreise} />
    </section>

    <CtaDuo />
  </main>
  <SiteFooter />
</Layout>
