---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  noindex = false,
  title = "Immersive Markets — Der externe Modernisierungspartner für Nachfolger",
  description =
    "Ich mache Traditionsunternehmen bereit für die nächste Generation: an Mitarbeitern, Kunden und Inhabern. Beratung und Umsetzung aus einer Hand, remote-first, als monatliche Partnerschaft.",
} = Astro.props;

// Vorschau für geteilte Links (LinkedIn, WhatsApp, Slack) mit dem IM-Logo.
const siteUrl = "https://immersive-markets.de";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.jpg`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Immersive Markets" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Immersive Markets – Der externe Modernisierungspartner für Nachfolger" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>

    <script
      async
      src="https://stats.immersive-markets.de/script.js"
      data-website-id="1d712274-a850-447b-9dce-33157b51481b"></script>
  </head>
  <body class="min-h-screen bg-white text-ink">
    <slot />

    <script>
      // Hero e-mail fields hand the address to /gespraech without putting it in the URL.
      document.querySelectorAll<HTMLFormElement>("form[data-handoff]").forEach((form) => {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const email = form.querySelector<HTMLInputElement>("input[type=email]")?.value ?? "";
          try {
            if (email) sessionStorage.setItem("im-email", email);
          } catch {}
          window.location.href = "/gespraech";
        });
      });
      const target = document.querySelector<HTMLInputElement>("input[data-prefill-email]");
      if (target) {
        try {
          const stored = sessionStorage.getItem("im-email");
          if (stored && !target.value) target.value = stored;
        } catch {}
      }
    </script>

    <script>
      // Progressive enhancement for Web3Forms-backed forms.
      // Without JS, forms submit natively (POST + hidden `redirect`) and still work.
      document.querySelectorAll<HTMLFormElement>("form[data-web3form]").forEach((form) => {
        form.addEventListener("submit", async (e) => {
          // `submit` only fires after native HTML5 validation passes.
          e.preventDefault();

          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const original = button?.textContent ?? "";
          if (button) {
            button.disabled = true;
            button.textContent = "Wird gesendet …";
          }

          const data = new FormData(form);
          const danke = form.dataset.danke || "/gespraech/danke";
          const echoField = form.dataset.echo || "firma";
          const echo = String(data.get(echoField) ?? "");

          try {
            const res = await fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: { Accept: "application/json" },
              body: data,
            });
            const json = await res.json();

            if (res.ok && json.success) {
              try {
                if (echo) sessionStorage.setItem("im-echo", echo);
              } catch {}
              window.location.href = danke;
              return;
            }
            throw new Error(json.message || "Submission failed");
          } catch (err) {
            if (button) {
              button.disabled = false;
              button.textContent = original;
            }
            alert(
              "Ihre Anfrage konnte gerade nicht gesendet werden. Bitte versuchen Sie es erneut oder schreiben Sie an info@immersive-markets.de."
            );
          }
        });
      });
    </script>
  </body>
</html>
